[package]
name = "rodit-near"
version = "0.1.0"
edition = "2021"
authors = ["Your Name <your.email@rodit.org>"]

[lib]
crate-type = ["cdylib"]

[dependencies]
near-sdk = "5.5.0"
borsh = "0.9"  # Add the Borsh dependency
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"

[profile.release]
codegen-units = 1
opt-level = "z"
lto = true
debug = false
panic = "abort"
overflow-checks = true

[workspace]
members = []